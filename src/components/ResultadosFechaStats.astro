---
const { stats = [] } = Astro.props;

const layoutClasses = [
  "lg:col-span-4",
  "lg:col-span-4",
  "lg:col-span-4",
  "lg:col-span-4",
  "lg:col-span-4",
  "lg:col-span-4",
  "lg:col-span-4",
  "lg:col-span-4",
  "lg:col-span-4",
];
---

<section class="bg-slate-100 py-10 md:py-12">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="mx-auto mb-7 max-w-3xl text-center">
      <p class="text-2xl font-extrabold uppercase leading-tight text-coral md:text-3xl">
        Resultados
      </p>
      <h2 class="mt-1 text-2xl font-extrabold uppercase leading-tight text-primary-700 md:text-3xl">
        A la fecha
      </h2>
    </div>

    <div class="mx-auto grid max-w-5xl gap-3 sm:grid-cols-2 md:gap-4 lg:grid-cols-12 lg:items-stretch">
      {stats.map((stat: any, index: number) => (
        <article class={`min-h-30 rounded-lg bg-white px-4 py-4 shadow-md shadow-slate-900/15 ring-1 ring-slate-200 transition duration-300 hover:-translate-y-0.5 hover:shadow-lg sm:min-h-32 sm:px-5 ${layoutClasses[index] ?? "lg:col-span-4"}`}>
          <div class="flex h-full flex-col items-center justify-center text-center">
            <div data-stat-icon class="flex h-9 w-9 shrink-0 items-center justify-center text-coral md:h-10 md:w-10" set:html={stat.icon}></div>

            <div class="mt-2 flex min-h-9 items-center justify-center">
              <p data-stat-value class="text-2xl font-extrabold leading-none text-coral md:text-3xl">
                {stat.prefix}
                {stat.displayValue ? (
                  <span>{stat.displayValue}</span>
                ) : (
                  <span class="stat" data-target={stat.value}>0</span>
                )}
                {stat.suffix}
              </p>
            </div>

            <p data-stat-label class="mt-2 min-h-9 max-w-56 text-pretty text-sm font-bold leading-snug text-primary-700 md:text-[15px]">
              {stat.label}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style is:global>
  [data-stat-icon] svg {
    display: block;
    height: 100%;
    width: 100%;
  }

  [data-stat-icon] svg [fill]:not([fill="none"]) {
    fill: currentColor;
  }

  [data-stat-icon] svg [stroke]:not([stroke="none"]) {
    stroke: currentColor;
  }

  [data-stat-value],
  [data-stat-label] {
    overflow-wrap: anywhere;
  }
</style>
