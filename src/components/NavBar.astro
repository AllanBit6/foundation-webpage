---
import ContactOverlay from "./ContactOverlay.astro";

const { pathname } = Astro.url;

const isActive = (path: any) =>
  pathname === path || pathname.startsWith(path + "/");
---

<header class="fixed left-0 top-0 z-50 w-full">
  <ContactOverlay />

  <nav class="border-b border-coral/20 bg-white/95 px-5 py-4 shadow-sm backdrop-blur lg:px-6">
    <div class="mx-auto flex max-w-7xl items-center justify-between">

      <!-- Logo -->
      <a href="/" class="flex items-center">
        <img
          src="/images/logo.jpg"
          class="mr-3 h-8 sm:h-10 lg:h-14"
          alt="Logo"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </a>

      <!-- Desktop Menu -->
      <div class="hidden lg:flex lg:flex-1 lg:justify-center">
        <ul class="flex items-center space-x-8 font-semibold">

          <li>
            <a
              href="/"
              class={`transition ${
                isActive("/")
                  ? "font-bold text-coral"
                  : "text-primary-700 hover:text-coral"
              }`}
            >
              Inicio
            </a>
          </li>

          <li>
            <a
              href="/nosotros"
              class={`transition ${
                isActive("/nosotros")
                  ? "font-bold text-coral"
                  : "text-primary-700 hover:text-coral"
              }`}
            >
              Nosotros
            </a>
          </li>

          <li>
            <a
              href="/programas"
              class={`transition ${
                isActive("/programas")
                  ? "font-bold text-coral"
                  : "text-primary-700 hover:text-coral"
              }`}
            >
              Programas
            </a>
          </li>

          <li>
            <a
              href="/logros"
              class={`transition ${
                isActive("/logros")
                  ? "font-bold text-coral"
                  : "text-primary-700 hover:text-coral"
              }`}
            >
              Logros
            </a>
          </li>

          <li>
            <a
              href="/carreras"
              class={`transition ${
                isActive("/carreras")
                  ? "font-bold text-coral"
                  : "text-primary-700 hover:text-coral"
              }`}
            >
              Carreras
            </a>
          </li>

          <li>
            <a
              href="/aplicacion"
              class={`transition ${
                isActive("/aplicacion")
                  ? "font-bold text-coral"
                  : "text-primary-700 hover:text-coral"
              }`}
            >
              Proceso
            </a>
          </li>

        </ul>
      </div>

      <!-- CTA Buttons -->
      <div class="hidden items-center gap-2 lg:flex">

        <a
          href="/aplicacion#formulario"
          class={`rounded-lg px-4 py-2 text-sm font-semibold shadow-sm transition ${
            isActive("/aplicacion")
              ? "bg-coral text-white"
              : "bg-coral text-white hover:bg-coral-muted"
          }`}
        >
          Aplicar a una beca
        </a>

        <a
          href="/tourism-with-purpose"
          class={`rounded-lg px-4 py-2 text-sm font-semibold shadow-sm transition ${
            isActive("/tourism-with-purpose")
              ? "bg-sun text-primary-950"
              : "bg-sun text-primary-950 hover:bg-coral hover:text-white"
          }`}
        >
        Tourism with Purpose
        </a>

        <a
          href="/involucrate"
          class={`rounded-lg border px-4 py-2 text-sm font-semibold transition ${
            isActive("/involucrate")
              ? "border-teal bg-teal-soft text-primary-900"
              : "border-teal/30 bg-teal-soft text-primary-800 hover:border-teal hover:bg-white"
          }`}
        >
          Quiero apoyar
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="menu-btn"
        class="ml-1 inline-flex items-center rounded-lg p-2 text-primary-700 hover:bg-coral-soft hover:text-coral lg:hidden"
        aria-label="Abrir menu"
      >
        <span class="text-2xl leading-none">&#9776;</span>
      </button>

    </div>
  </nav>

  <!-- MOBILE MENU -->
  <div
  id="mobile-menu"
  class="pointer-events-none max-h-0 -translate-y-2 overflow-hidden border-t border-secondary/60 bg-white opacity-0 shadow-sm transition-all duration-300 ease-out lg:hidden"
>
  <ul class="mx-auto flex max-w-md flex-col gap-8 px-6 py-6 text-lg font-semibold text-primary-800">

    <li>
      <a href="/" class={isActive("/") ? "font-bold text-coral" : ""}>
        Inicio
      </a>
    </li>

    <li>
      <a href="/nosotros" class={isActive("/nosotros") ? "font-bold text-coral" : ""}>
        Nosotros
      </a>
    </li>

    <li>
      <a href="/programas" class={isActive("/programas") ? "font-bold text-coral" : ""}>
        Programas
      </a>
    </li>

    <li>
      <a href="/logros" class={isActive("/logros") ? "font-bold text-coral" : ""}>
        Logros
      </a>
    </li>

    <li>
      <a href="/carreras" class={isActive("/carreras") ? "font-bold text-coral" : ""}>
        Carreras
      </a>
    </li>

    <li>
      <a href="/aplicacion" class={isActive("/aplicacion") ? "font-bold text-coral" : ""}>
        Proceso
      </a>
    </li>

    <hr class="border-primary-200" />

    <li>
      <a
        href="/aplicacion#formulario"
        class="block rounded-lg bg-coral px-4 py-3 text-center text-base text-white shadow-sm"
      >
        Aplicar a una beca
      </a>
    </li>

    <li>
      <a
        href="/tourism-with-purpose"
        class="block rounded-lg bg-sun px-4 py-3 text-center text-base font-bold text-primary-950 shadow-sm"
      >
      Tourism with Purpose
      </a>
    </li>

    <li>
      <a
        href="/involucrate"
        class="block rounded-lg border border-teal/30 bg-teal-soft px-4 py-3 text-center text-base"
      >
        Quiero apoyar
      </a>
    </li>

  </ul>
</div>
</header>
