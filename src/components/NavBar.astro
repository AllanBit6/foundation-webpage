---
import ContactOverlay from "./ContactOverlay.astro";

const { pathname } = Astro.url;

const isActive = (path: any) =>
  pathname === path || pathname.startsWith(path + "/");

const navItems = [
  { label: "Inicio", href: "/" },
  { label: "Nosotros", href: "/nosotros" },
  { label: "Programas", href: "/programas" },
  { label: "Carreras", href: "/carreras" },
  { label: "Proceso", href: "/aplicacion" },
  { label: "Logros", href: "/logros" },
];

const actionItems = [
  {
    label: "Aplicar a beca",
    href: "/aplicacion#formulario",
    activePath: "/aplicacion",
    className: "bg-coral text-white hover:bg-coral-muted",
    activeClassName: "bg-coral text-white",
    mobileClassName: "bg-coral text-white",
  },
  {
    label: "Quiero apoyar",
    href: "/involucrate",
    activePath: "/involucrate",
    className: "border border-teal/30 bg-teal-soft text-primary-800 hover:border-teal hover:bg-white",
    activeClassName: "border border-teal bg-teal-soft text-primary-900",
    mobileClassName: "border border-teal/30 bg-teal-soft text-primary-800",
  },
  {
    label: "Tourism with Purpose",
    href: "/tourism-with-purpose",
    activePath: "/tourism-with-purpose",
    className: "bg-sun text-primary-950 hover:bg-coral hover:text-white",
    activeClassName: "bg-sun text-primary-950",
    mobileClassName: "bg-sun text-primary-950",
  },
];
---

<header class="fixed left-0 top-0 z-50 w-full">
  <ContactOverlay />

  <nav class="border-b border-coral/20 bg-white/95 px-5 py-4 shadow-sm backdrop-blur lg:px-6">
    <div class="mx-auto flex max-w-7xl items-center justify-between">

      <!-- Logo -->
      <a href="/" class="flex items-center">
        <img
          src="/images/logo.jpg"
          class="mr-3 h-8 sm:h-10 lg:h-14"
          alt="Logo"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </a>

      <!-- Desktop Menu -->
      <div class="hidden lg:flex lg:flex-1 lg:justify-center">
        <ul class="flex items-center gap-7 font-semibold">
          {navItems.map((item) => {
            const active = isActive(item.href);

            return (
              <li>
                <a
                  href={item.href}
                  aria-current={active ? "page" : undefined}
                  class={`transition ${
                    active
                      ? "font-bold text-coral"
                      : "text-primary-700 hover:text-coral"
                  }`}
                >
                  {item.label}
                </a>
              </li>
            );
          })}
        </ul>
      </div>

      <!-- CTA Buttons -->
      <div class="hidden items-center gap-2 lg:flex">
        {actionItems.map((item) => {
          const active = isActive(item.activePath);

          return (
            <a
              href={item.href}
              aria-current={active ? "page" : undefined}
              class={`rounded-lg px-4 py-2 text-sm font-semibold shadow-sm transition ${
                active ? item.activeClassName : item.className
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="menu-btn"
        class="ml-1 inline-flex items-center rounded-lg p-2 text-primary-700 hover:bg-coral-soft hover:text-coral lg:hidden"
        aria-label="Abrir menu"
        aria-expanded="false"
      >
        <span class="text-2xl leading-none">&#9776;</span>
      </button>

    </div>
  </nav>

  <!-- MOBILE MENU -->
  <div
  id="mobile-menu"
  class="pointer-events-none max-h-0 -translate-y-2 overflow-hidden border-t border-secondary/60 bg-white opacity-0 shadow-sm transition-all duration-300 ease-out lg:hidden"
>
  <ul class="mx-auto flex max-w-md flex-col gap-5 px-6 py-6 text-lg font-semibold text-primary-800">

    {navItems.map((item) => {
      const active = isActive(item.href);

      return (
        <li>
          <a
            href={item.href}
            aria-current={active ? "page" : undefined}
            class={`block rounded-lg px-3 py-2 transition ${
              active ? "bg-coral-soft font-bold text-coral" : "hover:bg-secondary-soft hover:text-coral"
            }`}
          >
            {item.label}
          </a>
        </li>
      );
    })}

    <hr class="border-primary-200" />

    {actionItems.map((item) => (
      <li>
        <a
          href={item.href}
          class={`block rounded-lg px-4 py-3 text-center text-base font-semibold shadow-sm ${item.mobileClassName}`}
        >
          {item.label}
        </a>
      </li>
    ))}

  </ul>
</div>
</header>
