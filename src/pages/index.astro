---
import Layout from "../layouts/Layout.astro";
import GuatemalaMap from "../components/GuatemalaMap.astro";
import ResultadosFechaStats from "../components/ResultadosFechaStats.astro";
import { getDailyQuote } from "../scripts/dailyQuotes";
const dailyQuote = getDailyQuote();

const testimonios = [
  {
    nombre: "Arellys Cuá",
    rol: "Becada",
    color: "coral",
    imagen: "/images/testimonio2.jpeg",
    resumen:
      "Soy originaria de San Cristóbal Totonicapán y gracias a la beca de Fundación Transformando Vidas pude estudiar Perito Contador Bilingüe. Este apoyo me ayudó a fortalecer mis estudios, desarrollar mis capacidades y avanzar con disciplina y gratitud.",
    historia:
      "Mi nombre es Arellys Betzabé Cua, soy originaria de San Cristóbal Totonicapán, tuve la oportunidad de estudiar la carrera de Perito Contador Bilingüe en el Instituto Tecnológico Tec Zión, gracias a las becas que ofrece la Fundación Transformando Vidas. Me considero una persona optimista, perseverante y comprometida, alguien que procura dar la milla extra en cada etapa de su vida. Esa actitud me ha permitido avanzar con disciplina, responsabilidad y gratitud, reconociendo que cada oportunidad debe aprovecharse con excelencia. La beca recibida a través de Fundación Transformando Vidas fue una oportunidad muy valiosa en mi formación. Gracias a este apoyo pude fortalecer mis estudios, desarrollar mis capacidades y prepararme para continuar creciendo académica y profesionalmente. Actualmente estudio en la Universidad Rafael Landívar, en la carrera de Contador Público y Auditor, lo cual representa para mí un gran honor y una gran responsabilidad. Agradezco profundamente a Fundación Transformando Vidas por la labor que realiza al apoyar a jóvenes que desean continuar sus estudios y cumplir sus sueños. Gracias por creer en los jóvenes. Gracias por apoyar la educación. Gracias por transformar vidas.",
  },
  {
    nombre: "Juan Cop",
    rol: "Becado",
    color: "teal",
    imagen: "/images/testimonio1.jpg",
    resumen:
      "Al principio no creía que el estudio fuera para mí, pero con disciplina y el apoyo de la fundación pude graduarme como Bachiller en Ciencias Biológicas. Hoy sigo avanzando con más confianza y esperanza.",
    historia:
      "Mi nombre es Juan Cop. Nací el 22 de agosto de 2006 y desde niño he tenido una profunda pasión por la ciencia, el arte y la fe en Dios. Crecí con sueños grandes, pero también con desafíos que muchas veces parecían más grandes que mis propias fuerzas. No inicié mi vida académica como un estudiante destacado. Al principio, incluso llegué a pensar que el estudio no era para mí. Sin embargo, con el tiempo comprendí que el esfuerzo, la disciplina, la perseverancia y una actitud correcta podían transformar mi historia. Gracias a la beca recibida, pude continuar mis estudios, fortalecer mis capacidades y acercarme cada vez más a uno de mis mayores sueños: convertirme en médico. Hoy sigo avanzando, con gratitud, disciplina y fe, hacia la meta de convertirme en un profesional que sirva a Dios, a mi comunidad y a Guatemala.",
  },
  {
    nombre: "Jonathan Aguilar",
    rol: "Becado",
    color: "sun",
    imagen: "/images/testimonio3.jpg",
    resumen:
      "Desde Nebaj llegué a Tec Zión con una beca de Transformando Vidas, y hoy sigo avanzando en la Universidad Francisco Marroquín. Ese apoyo me ayudó a combinar estudios, liderazgo y servicio con más seguridad y propósito.",
    historia:
      "Mi nombre es Jonatan Josué Aguilar Ramírez. Nací el 5 de enero de 2005 en Nebaj, Quiché, Guatemala, en un entorno familiar marcado por el trabajo, el comercio y la responsabilidad. Desde muy pequeño aprendí que cada logro requiere esfuerzo, disciplina y compromiso. Llegar a Tec Zión representó una decisión importante para mí y para mi familia. Gracias a mi desempeño académico y personal, recibí una beca de la Fundación Transformando Vidas, apoyo que fue clave para seguir adelante con mis estudios. Hoy soy estudiante de tercer año de la Licenciatura en Computer Science en la Universidad Francisco Marroquín. La beca no fue solamente un apoyo económico; fue una oportunidad que fortaleció mi camino, abrió nuevas posibilidades y me impulsó a creer que los sueños pueden alcanzarse cuando se combinan esfuerzo, excelencia y acompañamiento.",
  },
  {
    nombre: "Allan Lacán",
    rol: "Becado",
    color: "primary",
    imagen: "/images/testimonio4.jfif",
    resumen:
      "Gracias a la beca pude estudiar Electrónica y Dispositivos Digitales y llegar a ser primer lugar de mi promoción. Hoy quiero usar ese conocimiento para ayudar a mi comunidad.",
    historia:
      "Mi nombre es Allan Daniel Lacán Vásquez, originario de la cabecera de Totonicapán. Gracias al apoyo de Fundación Transformando Vidas y al acceso a una beca completa, tuve la oportunidad de estudiar la carrera de Perito en Electrónica y Dispositivos Digitales, graduándome como primer lugar de mi promoción. Durante mi formación, desarrollé habilidades técnicas y de liderazgo que me permitieron vivir experiencias importantes, como participar en la Olimpiada Nacional de Ciencias 2023 en el área de Física Diversificado, donde obtuve el cuarto lugar a nivel nacional. Mi mayor deseo es acercar la educación tecnológica a más personas y hacer que la tecnología sea una herramienta accesible para transformar vidas.",
  },
];

const iconBirrete = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 10L12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5"/><path d="M22 10v6"/></svg>`;
const iconComunidad = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`;
const iconEmprendimiento = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 5c-1.5-1.2-3.6-2-6-2-5 0-9 3.1-9 7 0 2.2 1.3 4.2 3.4 5.5L7 21h5l.8-3c.4 0 .8 0 1.2-.1l1 3.1h5l-.8-5.2A6.8 6.8 0 0 0 21 11h1a1 1 0 0 0 1-1V8a1 1 0 0 0-1-1h-1.6c-.3-.7-.8-1.4-1.4-2Z"/><path d="M2 9v1"/><path d="M16 8h.01"/></svg>`;
const iconSalud = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.5-1.5 3-3.3 3-5.7A5.3 5.3 0 0 0 12 5.1 5.3 5.3 0 0 0 2 8.3c0 2.4 1.5 4.2 3 5.7l7 7 7-7Z"/><path d="M12 8v6"/><path d="M9 11h6"/></svg>`;
const iconAmbiente = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 20A7 7 0 0 1 4 13c0-5 4-9 16-9 0 12-4 16-9 16Z"/><path d="M4 20c4-4 8-8 16-16"/></svg>`;

const resultadosFecha = [
  {
    value: 7000,
    suffix: "+",
    label: "Jóvenes y niños capacitados",
    icon: iconComunidad,
  },
  {
    value: 6000,
    suffix: "+",
    label: "Estudiantes becados",
    icon: iconBirrete,
  },
  {
    value: 10,
    suffix: "+",
    label: "Carreras apoyadas",
    icon: iconBirrete,
  },
  {
    value: 3000,
    suffix: "+",
    label: "Padres de familia capacitados",
    icon: iconComunidad,
  },
  {
    value: 10,
    suffix: " años",
    label: "De apoyo educativo sostenido",
    icon: iconBirrete,
  },
  {
    value: 10000,
    suffix: "+",
    label: "Familias emprendedoras beneficiadas",
    icon: iconEmprendimiento,
  },
  {
    value: 10,
    suffix: "+",
    label: "Cooperativas de desarrollo rural apoyadas",
    icon: iconEmprendimiento,
  },
  {
    value: 2007,
    label: "Primera farmacia comunitaria",
    icon: iconSalud,
  },
  {
    value: 5,
    label: "Líneas de acción ambiental",
    icon: iconAmbiente,
  },
];

const coloresTestimonio = {
  coral: {
    card: "border-coral/50 bg-coral text-white hover:bg-coral-muted",
    title: "text-white",
    summary: "text-white/90",
    details: "bg-coral/80",
    summaryButton: "border-white/20 bg-white/10 text-white hover:bg-white/20",
    overlay: "bg-coral/95",
    chip: "bg-white/15 text-white",
    action: "text-white/80",
  },
  teal: {
    card: "border-teal/50 bg-teal text-white hover:bg-teal/90",
    title: "text-white",
    summary: "text-white/90",
    details: "bg-teal/80",
    summaryButton: "border-white/20 bg-white/10 text-white hover:bg-white/20",
    overlay: "bg-teal/95",
    chip: "bg-white/15 text-white",
    action: "text-white/80",
  },
  sun: {
    card: "border-sun/60 bg-sun text-primary-950 hover:bg-sun/85",
    title: "text-primary-950",
    summary: "text-primary-900",
    details: "bg-white/35",
    summaryButton: "border-primary-950/15 bg-white/35 text-primary-950 hover:bg-white/50",
    overlay: "bg-sun/95",
    chip: "bg-primary-950/10 text-primary-950",
    action: "text-primary-800",
  },
  primary: {
    card: "border-primary-600 bg-primary-800/90 text-white hover:bg-primary-900/95",
    title: "text-white",
    summary: "text-primary-100",
    details: "bg-primary-900/80",
    summaryButton: "border-white/20 bg-white/10 text-white hover:bg-white/20",
    overlay: "bg-primary-950/80",
    chip: "bg-white/10 text-white/80",
    action: "text-secondary",
  },
};

---

<Layout>
  <section class="relative min-h-screen overflow-hidden bg-primary-900">

  <!-- Imagen de fondo -->
  <img
    src="/images/home1.JPG"
    alt="Estudiantes beneficiados por la fundación"
    class="absolute inset-0 h-full w-full object-cover"
    loading="eager"
    decoding="async"
    fetchpriority="high"
  />

  <!-- Overlay -->
  <div class="absolute inset-0 bg-linear-to-r from-primary-950/85 via-primary-900/60 to-primary-900/20"></div>

  <!-- Contenido -->
  <div class="relative mx-auto flex min-h-screen max-w-7xl items-center px-6 py-20">

    <div class="max-w-2xl animate fade-up">

      <!-- Badge -->
      <span
        class="mb-5 inline-block rounded-full bg-white/10 px-4 py-2 text-sm font-semibold tracking-wide text-white backdrop-blur-md"
      >
        Becas para jóvenes rurales en Guatemala
      </span>

      <!-- Título -->
      <h1
        class="mb-6 text-5xl font-extrabold leading-tight text-white md:text-6xl xl:text-7xl"
      >
        Accede a una beca y
        <span class="text-secondary">
          transforma tu futuro
        </span>
      </h1>

      <!-- Texto -->
      <p
        class="mb-8 max-w-xl text-lg leading-relaxed text-white/90 md:text-xl"
      >
        Apoyamos a jóvenes con talento y compromiso para que puedan acceder
        a educación, oportunidades reales y construir una mejor historia.
      </p>

      <!-- Botones -->
      <div class="flex flex-col gap-4 sm:flex-row">

        <a
          href="/aplicacion"
          class="rounded-lg bg-coral px-7 py-3 font-semibold text-white shadow-lg shadow-coral/25 transition hover:scale-105 hover:bg-coral-muted"
        >
          Aplicar a beca
        </a>

        <a
          href="#como-aplicar"
          class="rounded-lg border border-white/30 bg-white/10 px-7 py-3 font-semibold text-white backdrop-blur-md transition hover:bg-white/20"
        >
          Ver requisitos
        </a>

      </div>

      <!-- Stats -->
      <div class=" mt-12 grid grid-cols-1 gap-4 border-t border-white/20 pt-8 sm:grid-cols-3 sm:gap-8">

        <div class="min-w-0 rounded-2xl bg-coral/90 px-3 py-4 shadow-lg shadow-coral/20 backdrop-blur">
          <p class="text-3xl font-extrabold text-white">
            +<span class="stat" data-target="6000">0</span>
          </p>
          <p class="text-sm text-white/70">
            Jóvenes becados
          </p>
        </div>

        <div class="rounded-2xl bg-teal/85 px-3 py-4 shadow-lg shadow-teal/20 backdrop-blur">
          <p class="text-3xl font-extrabold text-white">
            +<span class="stat" data-target="5">0</span>
          </p>
          <p class="text-sm text-white/70">
            Departamentos
          </p>
        </div>

        <div class="rounded-2xl bg-sun/90 px-3 py-4 text-primary-950 shadow-lg shadow-sun/20 backdrop-blur">
          <p class="text-3xl font-extrabold text-primary-950">
            +<span class="stat" data-target="20">0</span>
          </p>
          <p class="text-sm text-primary-900">
            Años de impacto
          </p>
        </div>

      </div>
    </div>
  </div>
</section>

  <section class="bg-primary-950 py-10">
    <div class="mx-auto max-w-4xl px-6 text-center">

      <blockquote class="text-xl italic text-white/90 md:text-2xl">
        “{dailyQuote.quote}”
      </blockquote>

      <p class="mt-4 text-sm font-semibold tracking-wide text-white/60">
        — {dailyQuote.author}, ({dailyQuote.source})
      </p>

    </div>
  </section>
  <section id="como-aplicar" class="animate fade-up delay-1000 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16">
      <div class="mx-auto mb-12 max-w-3xl text-center">
        <h2 class="mb-4 text-4xl font-extrabold text-primary-700">
          Cómo aplicar a la beca
        </h2>
        <p class="text-primary-800">
          Sigue estos pasos para iniciar tu proceso.
        </p>
      </div>

      <div
        class="animate fade-up delay-1000 grid gap-8 text-center md:grid-cols-3"
      >
        <div class="space-y-3">
          <div
            class="animate pop-strong delay-500 mx-auto flex h-16 w-16 items-center justify-center rounded-lg bg-coral"
          >
            <svg
              class="h-8 w-8"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 448 512"
              aria-hidden="true"
            >
              <path
                fill="rgb(255, 255, 255)"
                d="M448 75.2l0 361.7c0 24.3-19 43.2-43.2 43.2l-361.6 0C19.3 480 0 461.4 0 436.8L0 75.2C0 51.1 18.8 32 43.2 32l361.7 0c24 0 43.1 18.8 43.1 43.2zM410.7 436.8l0-361.6c0-3-2.6-5.8-5.8-5.8l-9.3 0-110.3 74.6-61.3-49.9-61.2 49.9-110.3-74.7-9.3 0c-3.2 0-5.8 2.8-5.8 5.8l0 361.7c0 3 2.6 5.8 5.8 5.8l361.7 0c3.2 .1 5.8-2.7 5.8-5.8zM150.2 186l0 37-73.5 0 0-37 73.5 0zm0 74.4l0 37.3-73.5 0 0-37.3 73.5 0zm11.1-147.3l54-43.7-118.5 0 64.5 43.7zm210 72.9l0 37-196 0 0-37 196 0zm0 74.4l0 37.3-196 0 0-37.3 196 0zM286.7 113.1l64.5-43.7-118.4 0 53.9 43.7zM371.3 335l0 37.3-99.4 0 0-37.3 99.4 0z"
              ></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold">1. Llena el formulario</h3>
          <p class="text-primary-800">
            Completa tu información personal y académica.
          </p>
        </div>

        <div class="space-y-3">
          <div
            class="animate pop-strong delay-500  mx-auto flex h-16 w-16 items-center justify-center rounded-lg bg-teal"
          >
            <svg
              class="h-8 w-8"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 576 512"
              aria-hidden="true"
            >
              <path
                fill="rgb(255, 255, 255)"
                d="M96 0C60.7 0 32 28.7 32 64l0 384c0 35.3 28.7 64 64 64l180 0c-22.7-31.5-36-70.2-36-112 0-100.6 77.4-183.2 176-191.3l0-38.1c0-17-6.7-33.3-18.7-45.3L290.7 18.7C278.7 6.7 262.5 0 245.5 0L96 0zM357.5 176L264 176c-13.3 0-24-10.7-24-24L240 58.5 357.5 176zM576 400a144 144 0 1 0 -288 0 144 144 0 1 0 288 0zm-86.6-60.9c7.1 5.2 8.7 15.2 3.5 22.3l-64 88c-2.8 3.8-7 6.2-11.7 6.5s-9.3-1.3-12.6-4.6l-40-40c-6.2-6.2-6.2-16.4 0-22.6s16.4-6.2 22.6 0l26.8 26.8 53-72.9c5.2-7.1 15.2-8.7 22.4-3.5z"
              ></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold">2. Adjunta documentos</h3>
          <p class="text-primary-800">Envía los requisitos solicitados.</p>
        </div>

        <div class="space-y-3">
          <div
            class="animate pop-strong delay-500 mx-auto flex h-16 w-16 items-center justify-center rounded-lg bg-sun"
          >
            <svg
              class="h-8 w-8"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 576 512"
              aria-hidden="true"
            >
              <path
                fill="rgb(255, 255, 255)"
                d="M48 195.8l209.2 86.1c9.8 4 20.2 6.1 30.8 6.1s21-2.1 30.8-6.1l242.4-99.8c9-3.7 14.8-12.4 14.8-22.1s-5.8-18.4-14.8-22.1L318.8 38.1C309 34.1 298.6 32 288 32s-21 2.1-30.8 6.1L14.8 137.9C5.8 141.6 0 150.3 0 160L0 456c0 13.3 10.7 24 24 24s24-10.7 24-24l0-260.2zm48 71.7L96 384c0 53 86 96 192 96s192-43 192-96l0-116.6-142.9 58.9c-15.6 6.4-32.2 9.7-49.1 9.7s-33.5-3.3-49.1-9.7L96 267.4z"
              ></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold">3. Proceso de seleccion</h3>
          <p class="text-primary-800">Evaluamos tu perfil y te contactamos.</p>
        </div>
      </div>

      <div class="mt-10 text-center">
        <a
          href="/aplicacion"
          class="rounded-lg bg-coral px-8 py-3 font-semibold text-white shadow-sm hover:bg-coral-muted"
        >
          Iniciar aplicación
        </a>
      </div>
    </div>
  </section>

  <section class="bg-secondary-soft">
    <div class="mx-auto max-w-7xl px-4 py-16">
      <h2 class="animate fade-in mb-12 text-center text-4xl font-extrabold text-primary-700">
        Historias que inspiran
      </h2>
      <div class="animate fade-in delay-500 grid gap-8 md:grid-cols-3">
        {testimonios.map((testimonio) => {
          const color = coloresTestimonio[testimonio.color as keyof typeof coloresTestimonio] ?? coloresTestimonio.primary;

          return (
          <article class={`group relative overflow-hidden rounded-3xl border shadow-lg transition duration-300 hover:-translate-y-1 hover:shadow-2xl ${color.card}`}>
            <img
              class="aspect-square w-full object-cover transition duration-500 group-hover:scale-105"
              src={testimonio.imagen}
              alt={testimonio.nombre}
              loading="lazy"
              decoding="async"
            />

            <div class="relative p-6">
              <div class={`mb-5 max-h-40 overflow-hidden text-xs leading-snug ${color.summary}`}>
                "{testimonio.resumen}"
              </div>

              <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                <h3 class={`font-bold ${color.title}`}>
                  {testimonio.nombre} ({testimonio.rol})
                </h3>
                <span class={`hidden rounded-full px-3 py-1 text-xs font-semibold transition group-hover:bg-white/20 md:inline ${color.chip}`}>
                  Pasa el cursor para leer todo
                </span>
              </div>

              <details class={`mt-4 rounded-2xl p-4 text-sm md:hidden ${color.details}`}>
                <summary class={`inline-flex w-full cursor-pointer items-center justify-between rounded-full border px-4 py-3 font-semibold transition ${color.summaryButton}`}>
                  Leer historia completa
                </summary>
                <p class={`mt-3 leading-relaxed ${color.summary}`}>
                  "{testimonio.historia}"
                </p>
              </details>
            </div>

            <div class={`absolute inset-0 hidden rounded-3xl p-6 opacity-0 transition duration-300 group-hover:block group-hover:opacity-100 md:block ${color.overlay}`}>
              <div class="flex h-full flex-col justify-between">
                <div class={`overflow-y-auto pr-1 text-sm leading-relaxed ${color.summary}`}>
                  "{testimonio.historia}"
                </div>
                <p class={`mt-6 text-right text-xs uppercase tracking-[0.24em] ${color.action}`}>
                  Desliza o haz hover para cerrar
                </p>
              </div>
            </div>
          </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="bg-coral">
    <div
      class="mx-auto grid max-w-5xl grid-cols-1 gap-8 py-16 text-center sm:grid-cols-3"
    >
      <!-- Jóvenes becados -->
      <div class="animate fade-up">
        <div
          class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-white/95 text-coral">
          <svg
            class="h-8 w-8"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 448 512"
            fill="currentColor"
          >
            <path
              d="M241.3-13c-11.4-2.3-23.1-2.3-34.5 0L19.3 24.5C8.1 26.7 0 36.6 0 48 0 58.3 6.5 67.3 16 70.6L16 144 .3 222.6c-.2 .9-.3 1.9-.3 2.9 0 8 6.5 14.6 14.6 14.6l34.9 0c8 0 14.6-6.5 14.6-14.6 0-1-.1-1.9-.3-2.9L48 144 48 77.3 96 86.9 96 144c0 70.7 57.3 128 128 128s128-57.3 128-128l0-57.1 76.7-15.3C439.9 69.3 448 59.4 448 48s-8.1-21.3-19.3-23.5L241.3-13zM224 224c-44.2 0-80-35.8-80-80l160 0c0 44.2-35.8 80-80 80zM120.1 320.1C58.7 348.3 16 410.3 16 482.3 16 498.7 29.3 512 45.7 512l154.3 0 0-146-57.4-43c-6.5-4.9-15.2-6.2-22.6-2.8zM248 512l154.3 0c16.4 0 29.7-13.3 29.7-29.7 0-72-42.7-134-104.1-162.1-7.4-3.4-16.1-2.1-22.6 2.8l-57.4 43 0 146z"
            ></path>
